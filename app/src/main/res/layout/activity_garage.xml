<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#06090D">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_foggy_forest"
        android:scaleType="centerCrop"
        android:contentDescription="Background" />

    <!-- Left Section: Vehicle Fleet Items (Bikes & Cycles) -->
    <LinearLayout
        android:id="@+id/layout_left_section"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginStart="24dp"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="28dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/layout_right_section"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GARAGE FLEET"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.14"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SELECT ANY PURCHASED VEHICLE TO TUNE ACCESSORIES"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.08"
            android:layout_marginBottom="10dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_vehicles"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:scrollbars="none" />

    </LinearLayout>

    <!-- Entire Right Window: Switches between Default Garage & Dedicated Vehicle Accessories -->
    <FrameLayout
        android:id="@+id/layout_right_section"
        android:layout_width="380dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="28dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- State A: Default Garage Right Section -->
        <LinearLayout
            android:id="@+id/layout_garage_default"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">

            <LinearLayout
                android:id="@+id/layout_title_box"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_days_gone_box"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tv_garage_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GARAGE"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.2" />

            </LinearLayout>

            <!-- Courier Wallet Balance -->
            <LinearLayout
                android:id="@+id/layout_wallet_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_days_gone_item"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:layout_marginBottom="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="COURIER BALANCE"
                    android:textColor="#94A3B8"
                    android:textSize="10.5sp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.12" />

                <TextView
                    android:id="@+id/tv_garage_wallet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WALLET: $100"
                    android:textColor="#10B981"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.08"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Guide hint box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_days_gone_item"
                android:padding="16dp"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WORKSHOP TUNING"
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.10" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Select any purchased vehicle on the left to open its accessories section and tune performance parts."
                    android:textColor="#94A3B8"
                    android:textSize="11.5sp"
                    android:fontFamily="sans-serif-condensed"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/btn_back_garage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RETURN"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.14"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:background="@drawable/bg_days_gone_item" />

        </LinearLayout>

        <!-- State B: Dedicated Accessories Section in the Entire Right Window -->
        <LinearLayout
            android:id="@+id/layout_accessories_section"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Vehicle Header Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_days_gone_box"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:layout_marginBottom="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_acc_vehicle_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SCOUT CRUISER"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.12" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACCESSORIES &amp; TUNING"
                    android:textColor="#38BDF8"
                    android:textSize="10.5sp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.10" />

            </LinearLayout>

            <!-- Wallet readout -->
            <TextView
                android:id="@+id/tv_acc_wallet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_days_gone_item"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="WALLET: $100"
                android:textColor="#10B981"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.08"
                android:layout_marginBottom="10dp" />

            <!-- Accessories List -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Accessory 1: Speed Part -->
                    <LinearLayout
                        android:id="@+id/card_acc_speed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_accessory_card"
                        android:padding="12dp"
                        android:layout_marginBottom="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tv_acc_speed_name"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="SPEED PART"
                                android:textColor="#FFFFFF"
                                android:textSize="13.5sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-condensed" />

                            <TextView
                                android:id="@+id/tv_acc_speed_level"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TIER 0/3"
                                android:textColor="#F59E0B"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-condensed" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_acc_speed_benefit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="+12% Speed Boost"
                            android:textColor="#94A3B8"
                            android:textSize="11sp"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/btn_acc_speed_buy"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="BUY ($150)"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-condensed"
                            android:letterSpacing="0.08"
                            android:gravity="center"
                            android:paddingVertical="7dp"
                            android:background="@drawable/bg_btn_dialog_buy"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>

                    <!-- Accessory 2: Cargo Part -->
                    <LinearLayout
                        android:id="@+id/card_acc_cargo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_accessory_card"
                        android:padding="12dp"
                        android:layout_marginBottom="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tv_acc_cargo_name"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="CARGO PART"
                                android:textColor="#FFFFFF"
                                android:textSize="13.5sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-condensed" />

                            <TextView
                                android:id="@+id/tv_acc_cargo_level"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TIER 0/3"
                                android:textColor="#10B981"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-condensed" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_acc_cargo_benefit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="+2 Cargo Slots"
                            android:textColor="#94A3B8"
                            android:textSize="11sp"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/btn_acc_cargo_buy"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="BUY ($100)"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-condensed"
                            android:letterSpacing="0.08"
                            android:gravity="center"
                            android:paddingVertical="7dp"
                            android:background="@drawable/bg_btn_dialog_buy"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>

                    <!-- Accessory 3: Utility Part -->
                    <LinearLayout
                        android:id="@+id/card_acc_util"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_accessory_card"
                        android:padding="12dp"
                        android:layout_marginBottom="4dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tv_acc_util_name"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="UTILITY PART"
                                android:textColor="#FFFFFF"
                                android:textSize="13.5sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-condensed" />

                            <TextView
                                android:id="@+id/tv_acc_util_level"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TIER 0/3"
                                android:textColor="#38BDF8"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-condensed" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_acc_util_benefit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="+15% Wet Grip"
                            android:textColor="#94A3B8"
                            android:textSize="11sp"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/btn_acc_util_buy"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="BUY ($120)"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-condensed"
                            android:letterSpacing="0.08"
                            android:gravity="center"
                            android:paddingVertical="7dp"
                            android:background="@drawable/bg_btn_dialog_buy"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>

                </LinearLayout>
            </ScrollView>

            <!-- Bottom Actions: Equip & Back to Garage -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_acc_equip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="EQUIP"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed"
                    android:gravity="center"
                    android:paddingVertical="10dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_btn_dialog_buy"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btn_acc_back"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="BACK"
                    android:textColor="#CBD5E1"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-condensed"
                    android:gravity="center"
                    android:paddingVertical="10dp"
                    android:background="@drawable/bg_btn_dialog_cancel"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
