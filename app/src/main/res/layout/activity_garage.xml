<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#06090D">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_foggy_forest"
        android:scaleType="fitXY"
        android:contentDescription="Background" />

    <!-- Left Section: Vehicle Fleet Items -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_vehicles"
        android:layout_width="490dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Right Section: Navigation Title, Wallet, and Return -->
    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="start"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/layout_title_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_days_gone_box"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tv_garage_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GARAGE"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.2" />

        </LinearLayout>

        <!-- Player Live Wallet Balance -->
        <LinearLayout
            android:id="@+id/layout_wallet_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_days_gone_item"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:layout_marginBottom="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COURIER BALANCE"
                android:textColor="#94A3B8"
                android:textSize="10.5sp"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.12" />

            <TextView
                android:id="@+id/tv_garage_wallet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WALLET: $100"
                android:textColor="#10B981"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.08"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/btn_back_garage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RETURN"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.14"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:background="@drawable/bg_days_gone_item" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
