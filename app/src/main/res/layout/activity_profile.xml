<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#06090D">

    <!-- Foggy forest background -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_foggy_forest"
        android:scaleType="centerCrop"
        android:contentDescription="Foggy Background" />

    <!-- Left Section: Profile Content -->
    <LinearLayout
        android:layout_width="480dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="start"
        android:layout_marginStart="32dp"
        android:layout_marginTop="36dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Clean Profile Header Row: Avatar + Name & Tap-to-Change hint -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <RelativeLayout
                android:id="@+id/layout_avatar_container"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/iv_avatar"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/avatar_1" />

            </RelativeLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:id="@+id/tv_profile_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RIDER"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.08"
                    android:shadowColor="#EE000000"
                    android:shadowDx="1"
                    android:shadowDy="2"
                    android:shadowRadius="4" />

                <TextView
                    android:id="@+id/tv_profile_uid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ID: #000000 | TAP PHOTO TO CHANGE"
                    android:textColor="#38BDF8"
                    android:textSize="11.5sp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.10"
                    android:layout_marginTop="3dp" />

            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33CBD5E1"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TOTAL EARNINGS"
            android:textColor="#94A3B8"
            android:textSize="10.5sp"
            android:letterSpacing="0.12" />

        <TextView
            android:id="@+id/tv_profile_cash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$100"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SYNDICATE SCORE"
            android:textColor="#94A3B8"
            android:textSize="10.5sp"
            android:letterSpacing="0.12" />

        <TextView
            android:id="@+id/tv_profile_points"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 PTS"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TIME IN TRANSIT"
            android:textColor="#94A3B8"
            android:textSize="10.5sp"
            android:letterSpacing="0.12" />

        <TextView
            android:id="@+id/tv_profile_playtime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0m 0s"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed" />

    </LinearLayout>

    <!-- Right Section: Navigation Title and Return -->
    <LinearLayout
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="start"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/layout_title_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_days_gone_box"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tv_profile_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PROFILE"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.2" />

        </LinearLayout>

        <TextView
            android:id="@+id/btn_share_score"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SHARE MY SCORE"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.14"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_days_gone_item" />

        <TextView
            android:id="@+id/btn_back_to_game"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RETURN"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.14"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:background="@drawable/bg_days_gone_item" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
