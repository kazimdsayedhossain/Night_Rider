<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF0369A1" />
            <stroke android:width="1.5dp" android:color="#FF7DD3FC" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF0284C7" />
            <stroke android:width="1.5dp" android:color="#FF38BDF8" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</selector>
