<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#0B0F15"
    app:cardCornerRadius="12dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VEHICLE PERFORMANCE TUNING"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.12" />

        <!-- Vehicle Name & Wallet -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/tv_dialog_vehicle_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Fixie Messenger"
                android:textColor="#38BDF8"
                android:textSize="13sp"
                android:fontFamily="sans-serif-condensed"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_dialog_wallet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WALLET: $1,250"
                android:textColor="#10B981"
                android:textSize="13sp"
                android:fontFamily="sans-serif-condensed"
                android:textStyle="bold" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1E293B"
            android:layout_marginVertical="12dp" />

        <!-- Component 1: Speed / Power -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#121822"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_speed_part_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Shimano Alfine Drivetrain"
                    android:textColor="#F59E0B"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed" />

                <TextView
                    android:id="@+id/tv_speed_tier_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TIER 1 / 3"
                    android:textColor="#FDE68A"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_speed_part_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Precision hollow-tech crankset &amp; racing sprocket chain for rapid cadence."
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:layout_marginTop="3dp" />

            <TextView
                android:id="@+id/tv_speed_stat_diff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Current: +12% Speed, +15% Accel -> Next: +24% Speed, +30% Accel"
                android:textColor="#CBD5E1"
                android:textSize="11.5sp"
                android:fontFamily="sans-serif-condensed"
                android:layout_marginTop="5dp" />

            <Button
                android:id="@+id/btn_dialog_upgrade_speed"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:minHeight="0dp"
                android:text="UPGRADE ($280)"
                android:textColor="#FFFFFF"
                android:backgroundTint="#B45309"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1E293B"
            android:layout_marginVertical="10dp" />

        <!-- Component 2: Cargo / Capacity -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#121822"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_cap_part_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Front Porteur Cargo Deck"
                    android:textColor="#10B981"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed" />

                <TextView
                    android:id="@+id/tv_cap_tier_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TIER 0 / 3"
                    android:textColor="#A7F3D0"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_cap_part_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reinforced alloy front rack with quick-release courier pannier bag mount."
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:layout_marginTop="3dp" />

            <TextView
                android:id="@+id/tv_cap_stat_diff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Current: 4 Pending Orders -> Next: 6 Pending Orders (+2 Slots)"
                android:textColor="#CBD5E1"
                android:textSize="11.5sp"
                android:fontFamily="sans-serif-condensed"
                android:layout_marginTop="5dp" />

            <Button
                android:id="@+id/btn_dialog_upgrade_cap"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:minHeight="0dp"
                android:text="UPGRADE ($100)"
                android:textColor="#FFFFFF"
                android:backgroundTint="#047857"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <!-- Close Button -->
        <Button
            android:id="@+id/btn_dialog_close"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:minHeight="0dp"
            android:text="DONE"
            android:textColor="#FFFFFF"
            android:backgroundTint="#334155"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:layout_marginTop="14dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
