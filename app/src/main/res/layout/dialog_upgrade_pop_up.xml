<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="440dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_dialog_theme"
        android:padding="22dp">

        <!-- Category Tag -->
        <TextView
            android:id="@+id/tv_popup_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UPGRADE ACCESSORY"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.12" />

        <!-- Accessory Name -->
        <TextView
            android:id="@+id/tv_popup_part_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACCESSORY NAME"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.08"
            android:layout_marginTop="4dp" />

        <!-- Tier Progression -->
        <TextView
            android:id="@+id/tv_popup_tier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TIER 1 / 3 TO TIER 2 / 3"
            android:textColor="#F59E0B"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.06"
            android:layout_marginTop="2dp" />

        <!-- Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33CBD5E1"
            android:layout_marginVertical="12dp" />

        <!-- What it improves -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WHAT IT IMPROVES:"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.10" />

        <TextView
            android:id="@+id/tv_popup_benefit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+12% Speed Boost"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp" />

        <!-- Price & Wallet -->
        <TextView
            android:id="@+id/tv_popup_cost_wallet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PRICE: $150 | WALLET: $500"
            android:textColor="#10B981"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.06" />

        <!-- Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33CBD5E1"
            android:layout_marginVertical="12dp" />

        <!-- Action Buttons: CANCEL and BUY -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btn_popup_cancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CANCEL"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"
                android:gravity="center"
                android:paddingVertical="10dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_btn_dialog_cancel"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_popup_buy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="BUY ($150)"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"
                android:gravity="center"
                android:paddingVertical="10dp"
                android:background="@drawable/bg_btn_dialog_buy"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
