<?xml version="1.0" encoding="utf-8"?>
<!-- Vehicle card for Garage RecyclerView -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardBackgroundColor="#121720"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Row: Name, Type Badge, Price/Status Tag -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_vehicle_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:fontFamily="sans-serif-condensed"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tv_vehicle_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:fontFamily="sans-serif-condensed"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:background="#1E293B"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tv_vehicle_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:fontFamily="sans-serif-condensed"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:background="#162A45" />

        </LinearLayout>

        <!-- Stats line -->
        <TextView
            android:id="@+id/tv_vehicle_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#94A3B8"
            android:textSize="11.5sp"
            android:fontFamily="sans-serif-condensed"
            android:layout_marginTop="5dp" />

        <!-- Upgrade Tiers readout row: Speed, Cargo, Utility -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_speed_badge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#F59E0B"
                android:textSize="10.5sp"
                android:fontFamily="sans-serif-condensed"
                android:text="⚡ SPEED: LV 0/3" />

            <TextView
                android:id="@+id/tv_cargo_badge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#10B981"
                android:textSize="10.5sp"
                android:fontFamily="sans-serif-condensed"
                android:text="📦 CARGO: LV 0/3" />

            <TextView
                android:id="@+id/tv_util_badge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.1"
                android:textColor="#38BDF8"
                android:textSize="10.5sp"
                android:fontFamily="sans-serif-condensed"
                android:text="🛠 UTILITY: LV 0/3" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1E293B"
            android:layout_marginVertical="8dp" />

        <!-- Buttons Row: Upgrade & Equip/Buy -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end|center_vertical">

            <TextView
                android:id="@+id/tv_tap_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#64748B"
                android:textSize="10.5sp"
                android:fontFamily="sans-serif-condensed"
                android:text="Tap to tune parts"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_upgrade"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minHeight="0dp"
                android:text="UPGRADE PARTS"
                android:textSize="11.5sp"
                android:fontFamily="sans-serif-condensed"
                android:textStyle="bold"
                android:textColor="#E2E8F0"
                android:backgroundTint="#243247"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="0dp" />

            <Button
                android:id="@+id/btn_equip"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minHeight="0dp"
                android:text="EQUIP"
                android:textSize="11.5sp"
                android:fontFamily="sans-serif-condensed"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#0F766E"
                android:paddingHorizontal="16dp"
                android:paddingVertical="0dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
